# Optional build-time seed for the Options page.
#
# Copy this file to `.env.local` (gitignored) and fill in the values you
# want pre-populated. Vite reads it at build time and inlines the values
# into the bundled service-worker JS. The Options page is still the source
# of truth — saving anything there overrides these defaults.
#
# Everything here is OPTIONAL. Leaving the file empty (or absent) just
# means the user fills in the Options page by hand on first run.
#
# ⚠️ The values are inlined into `dist/` as plain strings. Treat `dist/`
# the same way you treat a `.env` file: don't ship it to anyone else.
# Every user should run their own build with their own key.

VITE_DEFAULT_PROVIDER=openrouter
# Valid presets include: openrouter | openai | anthropic | google | groq |
# mistral | deepseek | together | xai | cerebras | fireworks | ollama |
# lm-studio | azure-openai | anthropic-foundry | custom-openai |
# custom-anthropic

VITE_DEFAULT_MODEL=openrouter/auto
# Any model ID supported by the selected service.

VITE_DEFAULT_API_KEY=

# Required for Azure/custom presets; optional as a preset override.
# A base URL or full chat endpoint is accepted.
VITE_DEFAULT_ENDPOINT=
